{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/pages/**/*.astro",
    "worker/index.ts",
    "src/lib/auth/dev.ts",
    "src/lib/score/dev-store.ts",
    "scripts/*.{ts,mjs}"
  ],
  "project": [
    "src/**/*.{ts,tsx,astro,css}",
    "worker/**/*.ts",
    "scripts/*.{ts,mjs}"
  ],
  "ignoreBinaries": ["wrangler"],
  "ignoreExportsUsedInFile": { "interface": true, "type": true }
}
