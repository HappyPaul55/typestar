{
  // Must match the connected Cloudflare Worker name, which Workers Builds
  // supplies as the CI worker name; a mismatch is overridden at deploy time and
  // logged as a warning.
  "name": "client-typestar-happypaul55-com",
  // The Worker serves the track API and the pretty /play routes; everything
  // else falls through to the asset server.
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  // The captions library pulls in `he` and `striptags`, which need Node
  // compatibility to resolve in the Worker runtime.
  "compatibility_flags": ["nodejs_compat"],
  // Production is the apex custom domain (typestar.happypaul55.com), managed in
  // the Cloudflare dashboard and enabled for Production and Preview traffic, so
  // every branch preview is served from <branch>.typestar.happypaul55.com. The
  // workers.dev route and version preview URLs stay disabled.
  "workers_dev": false,
  "preview_urls": false,
  // The fallback caption service, used only when YouTube's caption lookup
  // fails or returns nothing. Overridable here without touching code.
  "vars": {
    "CAPTION_FALLBACK_URL": "https://youtube.weblinq.dev/api/videoDetails",
    // Hostnames allowed on a Turnstile token. A listed hostname also allows its
    // subdomains (matching Turnstile's own hostname allowlist), so this covers
    // the branch preview hostnames too. The widget secret itself lives as a
    // Worker secret (TURNSTILE_SECRET), not here.
    "TURNSTILE_HOSTNAMES": "typestar.happypaul55.com",
    // The `from` address on sign-in emails. The domain must be onboarded to
    // Cloudflare Email Sending. See the README.
    "AUTH_EMAIL_FROM": "TypeStar <signin@typestar.happypaul55.com>"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these paths run the Worker; all other requests are served straight
    // from the edge asset cache.
    "run_worker_first": ["/api/*", "/play", "/play/*"]
  },
  // Processed tracks are cached here. Create the bucket with:
  //   bunx wrangler r2 bucket create typestar-tracks
  "r2_buckets": [
    {
      "binding": "TRACKS",
      "bucket_name": "typestar-tracks"
    }
  ],
  // Accounts (users, sessions, magic-link tokens) live in D1. Create it with:
  //   bun run db:create   (then paste the printed database_id here)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "typestar-auth",
      "database_id": "REPLACE_WITH_PRODUCTION_D1_ID"
    }
  ],
  // Transactional email (sign-in links). The domain must be onboarded to
  // Cloudflare Email Sending first: `bunx wrangler email sending enable …`.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  // Worker Previews — the build for a non-production branch, run with
  // `bunx wrangler preview` — do not inherit the production settings above, so
  // every binding and var a preview needs is repeated here. Previews use their
  // own R2 bucket, so a branch can fetch and cache new tracks without touching
  // the production cache. `TURNSTILE_SECRET` is a secret and cannot live in this
  // file; apply it to the Previews Base configuration (see the README).
  "previews": {
    "vars": {
      "CAPTION_FALLBACK_URL": "https://youtube.weblinq.dev/api/videoDetails",
      "TURNSTILE_HOSTNAMES": "typestar.happypaul55.com",
      "AUTH_EMAIL_FROM": "TypeStar <signin@typestar.happypaul55.com>"
    },
    "r2_buckets": [
      {
        "binding": "TRACKS",
        "bucket_name": "typestar-tracks-preview"
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "typestar-auth-preview",
        "database_id": "REPLACE_WITH_PREVIEW_D1_ID"
      }
    ],
    "send_email": [
      {
        "name": "EMAIL"
      }
    ]
  }
}
