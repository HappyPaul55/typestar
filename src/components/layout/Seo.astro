---
import type { SiteSettings } from "../../lib/site";
import { DEFAULT_LOCALE, HTML_LANG, OG_LOCALE, type Locale } from "../../i18n/locales";
import { tFor } from "../../i18n/astro";

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  path?: string;
  type?: string;
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  locale?: Locale;
  settings: SiteSettings;
}

const {
  title,
  description,
  path = "/",
  type = "website",
  noindex = false,
  breadcrumbs = [],
  locale = DEFAULT_LOCALE,
  settings,
} = Astro.props;

const normalise = (value: string) =>
  value === "/" ? "/" : value.replace(/\/+$/, "");

const canonical = new URL(normalise(path), settings.url).href;
const ogImage = new URL("/og-image.png", settings.url).href;
const t = tFor(locale);
const ogAlt = t("seo.ogAlt", { name: settings.name });

const author = {
  "@type": "Person",
  "@id": `${settings.authorUrl}/#person`,
  name: settings.author,
  url: settings.authorUrl,
  sameAs: [settings.authorUrl, settings.repo],
};

const application = {
  "@type": "WebApplication",
  "@id": `${settings.url}/#game`,
  name: settings.name,
  url: `${settings.url}/`,
  description,
  applicationCategory: "GameApplication",
  operatingSystem: "Any",
  browserRequirements: tFor(locale)("seo.requiresJs"),
  inLanguage: HTML_LANG[locale],
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "GBP" },
  author: { "@id": `${settings.authorUrl}/#person` },
  image: ogImage,
};

const website = {
  "@type": "WebSite",
  "@id": `${settings.url}/#website`,
  url: `${settings.url}/`,
  name: settings.name,
  description,
  inLanguage: HTML_LANG[locale],
  publisher: { "@id": `${settings.authorUrl}/#person` },
};

const graph: unknown[] = [author, application, website];

if (breadcrumbs.length > 0) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: new URL(normalise(crumb.path), settings.url).href,
    })),
  });
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<title data-seo="title">{title}</title>
<meta name="description" data-seo="description" content={description} />
<link rel="canonical" data-seo="canonical" href={canonical} />
<meta
  name="robots"
  content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
/>
<meta name="author" content={settings.author} />
<meta name="color-scheme" content="dark light" />
<link
  rel="sitemap"
  type="application/xml"
  title={t("seo.sitemap")}
  href="/sitemap-index.xml"
/>

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={settings.name} />
<meta property="og:title" data-seo="og:title" content={title} />
<meta property="og:description" data-seo="og:description" content={description} />
<meta property="og:url" data-seo="og:url" content={canonical} />
<meta property="og:locale" content={OG_LOCALE[locale]} />
<meta property="og:image" data-seo="og:image" content={ogImage} />
<meta property="og:image:type" data-seo="og:image:type" content="image/png" />
<meta property="og:image:width" data-seo="og:image:width" content="1200" />
<meta property="og:image:height" data-seo="og:image:height" content="630" />
<meta property="og:image:secure_url" data-seo="og:image:secure_url" content={ogImage} />
<meta property="og:image:alt" data-seo="og:image:alt" content={ogAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" data-seo="twitter:title" content={title} />
<meta name="twitter:description" data-seo="twitter:description" content={description} />
<meta name="twitter:image" data-seo="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" data-seo="twitter:image:alt" content={ogAlt} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
