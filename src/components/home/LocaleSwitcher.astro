---
import {
  DEFAULT_LOCALE,
  HTML_LANG,
  LOCALES,
  LOCALE_LABEL,
  type Locale,
} from "../../i18n/locales";
import { localeFromPath, tFor } from "../../i18n/astro";

const current = localeFromPath(Astro.url.pathname);
const t = tFor(current);

/** Only the landing page is localized so far, so every link points there. */
function href(locale: Locale): string {
  return locale === DEFAULT_LOCALE ? "/" : `/${locale}`;
}
---

<nav class="locale-switcher" aria-label={t("nav.language")}>
  {
    LOCALES.map((locale) => (
      <a
        href={href(locale)}
        hreflang={HTML_LANG[locale]}
        aria-current={locale === current ? "true" : undefined}
      >
        {LOCALE_LABEL[locale]}
      </a>
    ))
  }
</nav>
