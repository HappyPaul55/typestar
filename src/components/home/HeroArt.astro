---
/**
 * A stylised "screenshot" of the game for the homepage hero: the notebook
 * aesthetic, a YouTube-style video pane, a lyric highway with the active word
 * highlighted, and the HUD. Drawn as SVG so it stays crisp and carries no
 * third-party video content.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const mono = "'Space Mono', ui-monospace, 'SFMono-Regular', monospace";
const display = "'Space Grotesk', ui-sans-serif, system-ui, sans-serif";
const ink = "#0c0d0a";
const cream = "#fafaf4";
const yellow = "#ffd400";
const creamSoft = "rgba(250,250,244,0.6)";
const creamFaint = "rgba(250,250,244,0.28)";
const inkFaint = "rgba(12,13,10,0.22)";
const inkSoft = "rgba(12,13,10,0.34)";
---

<svg
  class={className || undefined}
  viewBox="0 0 560 400"
  role="img"
  aria-label="A screenshot of TypeStar: a YouTube video beside the lyric highway, with a word highlighted and a score, combo and accuracy in the HUD."
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- hard offset shadow -->
  <rect x="20" y="20" width="520" height="364" rx="12" fill={yellow} />

  <!-- card -->
  <rect x="0" y="0" width="520" height="364" rx="12" fill="#f3f4ee" stroke={ink} stroke-width="2" />

  <!-- browser chrome + HUD -->
  <path d="M0 12 a12 12 0 0 1 12 -12 h496 a12 12 0 0 1 12 12 v64 h-520 z" fill={ink} />
  <line x1="0" y1="38" x2="520" y2="38" stroke="rgba(250,250,244,0.12)" stroke-width="1" />

  <circle cx="20" cy="19" r="4" fill={creamFaint} />
  <circle cx="34" cy="19" r="4" fill={creamFaint} />
  <circle cx="48" cy="19" r="4" fill={yellow} />
  <text x="66" y="23" fill={creamSoft} font-family={mono} font-size="11">
    typestar.happypaul55.com/play
  </text>

  <!-- HUD -->
  <text x="20" y="55" fill={creamFaint} font-family={mono} font-size="8" letter-spacing="1">SCORE</text>
  <text x="20" y="71" fill={cream} font-family={display} font-size="16" font-weight="700">1,240</text>
  <text x="108" y="55" fill={creamFaint} font-family={mono} font-size="8" letter-spacing="1">COMBO</text>
  <text x="108" y="71" fill={yellow} font-family={display} font-size="16" font-weight="700">×3</text>
  <text x="196" y="55" fill={creamFaint} font-family={mono} font-size="8" letter-spacing="1">ACCURACY</text>
  <text x="196" y="71" fill={cream} font-family={display} font-size="16" font-weight="700">98%</text>
  <rect x="316" y="48" width="184" height="8" rx="4" fill="rgba(250,250,244,0.18)" />
  <rect x="316" y="48" width="72" height="8" rx="4" fill={yellow} />
  <text x="316" y="71" fill={creamFaint} font-family={mono} font-size="9">0:42 / 3:26</text>

  <!-- video pane -->
  <rect x="18" y="94" width="234" height="132" rx="8" fill={ink} />
  <polygon points="124,146 124,174 150,160" fill={yellow} />
  <rect x="30" y="206" width="210" height="5" rx="2.5" fill="rgba(250,250,244,0.22)" />
  <rect x="30" y="206" width="78" height="5" rx="2.5" fill={yellow} />

  <!-- lyric highway -->
  <rect x="430" y="96" width="74" height="22" rx="11" fill={yellow} />
  <text x="467" y="111" fill={ink} font-family={mono} font-size="10" font-weight="700" text-anchor="middle" letter-spacing="1">HARD</text>

  <text x="268" y="126" fill={inkFaint} font-family={display} font-size="22" font-weight="700">
    Type the words
  </text>
  <rect x="294" y="140" width="66" height="30" rx="5" fill={yellow} />
  <text x="268" y="164" fill={ink} font-family={display} font-size="22" font-weight="700">in </text>
  <text x="300" y="164" fill={ink} font-family={display} font-size="22" font-weight="700">time</text>
  <line x1="370" y1="142" x2="370" y2="168" stroke={ink} stroke-width="2" />
  <text x="268" y="202" fill={inkFaint} font-family={display} font-size="22" font-weight="700">
    as they arrive
  </text>
  <text x="268" y="236" fill={inkFaint} font-family={display} font-size="16" font-weight="700">
    a bit like guitar hero
  </text>

  <!-- song meta -->
  <text x="18" y="262" fill={ink} font-family={display} font-size="14" font-weight="700">
    Dasha — Austin
  </text>
  <text x="18" y="278" fill={inkSoft} font-family={mono} font-size="9" letter-spacing="1">
    OFFICIAL MUSIC VIDEO
  </text>

  <!-- progress -->
  <rect x="18" y="300" width="486" height="8" rx="4" fill="rgba(12,13,10,0.12)" />
  <rect x="18" y="300" width="126" height="8" rx="4" fill={yellow} />

  <!-- controls -->
  <g font-family={mono} font-size="9" font-weight="700" fill={ink}>
    <rect x="18" y="322" width="42" height="26" rx="6" fill="none" stroke={inkSoft} />
    <text x="39" y="339" text-anchor="middle">❚❚</text>
    <rect x="66" y="322" width="42" height="26" rx="6" fill="none" stroke={inkSoft} />
    <text x="87" y="339" text-anchor="middle">↺</text>
    <rect x="114" y="322" width="80" height="26" rx="6" fill="none" stroke={inkSoft} />
    <text x="154" y="339" text-anchor="middle">NORMAL</text>
    <rect x="200" y="322" width="60" height="26" rx="6" fill="none" stroke={inkSoft} />
    <text x="230" y="339" text-anchor="middle">SYNC</text>
    <rect x="266" y="322" width="60" height="26" rx="6" fill="none" stroke={inkSoft} />
    <text x="296" y="339" text-anchor="middle">SONG</text>
  </g>
</svg>
