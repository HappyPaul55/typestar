---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import HeroArt from "../components/home/HeroArt.astro";

const site = (await getEntry("site", "main"))!.data;

const steps = [
  {
    n: "01",
    title: "Pick a track",
    body: "Paste a YouTube link, or start from the featured list. TypeStar reads the captions and times every word.",
  },
  {
    n: "02",
    title: "Type to the beat",
    body: "Words light up as they arrive. Type each one before its moment passes — like Guitar Hero, for your keyboard.",
  },
  {
    n: "03",
    title: "Chase the score",
    body: "Chains build a multiplier and clean lines pay a bonus. Three difficulties, four run modes, endless replays.",
  },
];
---

<BaseLayout
  title={`${site.name} — ${site.tagline}`}
  description={site.description}
  path="/"
>
  <main id="main">
    <section
      class="on-ink grid-ink border-b border-line-ink bg-ink pt-[clamp(3rem,8vw,5rem)] pb-[clamp(3.5rem,8vw,6rem)]"
    >
      <Container>
        <div class="grid items-center gap-x-12 gap-y-12 lg:grid-cols-[1.05fr_1fr]">
          <div>
            <p class="comment">
              <span class="slash" aria-hidden="true">//</span> rhythm typing
            </p>
            <h1
              class="mt-4 max-w-[18ch] font-display text-[clamp(2.6rem,8vw,5rem)] leading-[0.98] font-bold tracking-[-0.035em] text-cream"
            >
              Type the lyrics <span class="mark">in time</span>.
            </h1>
            <p
              class="mt-6 max-w-[44rem] text-[clamp(1.02rem,1.6vw,1.2rem)] leading-[1.6] text-[rgba(250,250,244,0.7)]"
            >
              {site.description}
            </p>
            <div class="mt-9 flex flex-wrap gap-3.5">
              <Button href="/play" variant="primary">
                Play TypeStar <span aria-hidden="true">→</span>
              </Button>
              <Button href="/privacy" variant="outlineInk">Privacy</Button>
            </div>
          </div>

          <div>
            <HeroArt class="h-auto w-full" />
          </div>
        </div>
      </Container>
    </section>

    <section class="grid-paper bg-paper py-[clamp(3rem,8vw,5.5rem)]">
      <Container>
        <p class="comment">
          <span class="slash" aria-hidden="true">//</span> how it works
        </p>
        <div class="mt-6 grid gap-6 sm:grid-cols-3">
          {
            steps.map((step) => (
              <div class="card">
                <span class="font-mono text-[0.72rem] font-bold tracking-[0.14em] text-yellow-deep">
                  {step.n}
                </span>
                <h2 class="mt-3 font-display text-[1.15rem] font-bold tracking-[-0.01em]">
                  {step.title}
                </h2>
                <p class="mt-2 text-ink-soft">{step.body}</p>
              </div>
            ))
          }
        </div>
      </Container>
    </section>
  </main>
</BaseLayout>
