---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePage from "../components/home/HomePage.astro";
import { localeFromPath, tFor } from "../i18n/astro";

const site = (await getEntry("site", "main"))!.data;
const locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);
---

<BaseLayout
  title={`${site.name} — ${t("site.tagline")}`}
  description={t("site.description")}
  path="/"
>
  <HomePage />
</BaseLayout>
