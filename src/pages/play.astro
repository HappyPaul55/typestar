---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import GameApp from "../components/game/GameApp.tsx";
import EmbedButton from "../components/embed/EmbedButton.tsx";
import { FEATURED_TRACKS } from "../content/tracks/featured";
import { loadSeedRatings } from "../lib/track/seed";
import { localeFromPath, tFor } from "../i18n/astro";
import { localePath } from "../i18n/paths";

const site = (await getEntry("site", "main"))!.data;
const locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);
// Rated from the pre-warmed seed tracks at build time, so the featured badges
// match the rating the player sees once the track itself is opened.
const ratings = loadSeedRatings(FEATURED_TRACKS.map((track) => track.id));
// `breadcrumbs` feeds the SEO JSON-LD (Home → Play); the visible crumb is just
// `// play`, so it keeps the old lowercase comment style.
const breadcrumbs = [
  { name: "Home", path: localePath(locale, "/") },
  { name: "Play", path: localePath(locale, "/play") },
];
const crumbs = [{ name: t("play.crumb"), path: localePath(locale, "/play") }];
---

<BaseLayout
  title={`Play ${site.name}`}
  description={site.description}
  path="/play"
  breadcrumbs={breadcrumbs}
>
  <link
    slot="head"
    rel="preload"
    as="audio"
    type="audio/mpeg"
    href="/audio/error.mp3"
  />

  <main id="main">
    <section
      class="on-ink grid-ink border-b border-line-ink bg-ink pt-[clamp(2rem,5vw,3rem)] pb-[clamp(1.75rem,4vw,2.75rem)]"
    >
      <Container>
        <div class="play-head">
          <p
            id="play-rating"
            class="play-rating"
            title={t("play.ratingTitle")}
            hidden
          >
            <span class="play-rating__caption">
              <span class="slash" aria-hidden="true">//</span> {t("play.ratingComment")}
            </span>
            <span id="play-rating-value" class="play-rating__value">Medium</span>
          </p>
          <div class="play-head__text">
            <Breadcrumbs
              items={crumbs}
              tailId="play-breadcrumb-tail"
              tailLabel={t("play.localCrumb")}
              tailHref={localePath(locale, "/play/local")}
            />
            <h1
              id="play-title"
              class="mt-3 font-display text-[clamp(1.8rem,4.6vw,2.8rem)] leading-[1] font-bold tracking-[-0.03em] text-cream"
            >
              {site.name}
            </h1>
            <p
              id="play-subtitle"
              class="mt-3 max-w-[46rem] text-[clamp(0.96rem,1.4vw,1.1rem)] leading-[1.6] text-[rgba(250,250,244,0.7)]"
            >
              {t("play.subtitle", { tagline: site.tagline })}
            </p>
            <div class="mt-4">
              <EmbedButton client:load />
            </div>
          </div>
        </div>
      </Container>
    </section>

    <div class="game-zone grid-paper bg-paper">
      <GameApp client:load site={site} ratings={ratings} locale={locale} />
    </div>
  </main>
</BaseLayout>
