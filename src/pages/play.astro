---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import GameApp from "../components/game/GameApp.tsx";

const site = (await getEntry("site", "main"))!.data;
---

<BaseLayout
  title={`Play ${site.name}`}
  description={site.description}
  path="/play"
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Play", path: "/play" },
  ]}
>
  <main id="main">
    <section
      class="on-ink grid-ink border-b border-line-ink bg-ink pt-[clamp(5.5rem,11vw,7rem)] pb-[clamp(1.75rem,4vw,2.75rem)]"
    >
      <Container wide>
        <p class="comment">
          <span class="slash" aria-hidden="true">//</span> play
        </p>
        <h1
          id="play-title"
          class="mt-3 font-display text-[clamp(1.8rem,4.6vw,2.8rem)] leading-[1] font-bold tracking-[-0.03em] text-cream"
        >
          {site.name}
        </h1>
        <p
          id="play-subtitle"
          class="mt-3 max-w-[46rem] text-[clamp(0.96rem,1.4vw,1.1rem)] leading-[1.6] text-[rgba(250,250,244,0.7)]"
        >
          {site.tagline} — YouTube supplies the music and visuals; you type the
          lyrics as the words arrive.
        </p>
      </Container>
    </section>

    <div class="grid-paper bg-paper py-[clamp(2rem,5vw,3.5rem)]">
      <Container wide>
        <GameApp client:load site={site} />
      </Container>
    </div>
  </main>
</BaseLayout>
