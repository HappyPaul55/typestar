---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import AccountPanel from "../components/auth/AccountPanel.tsx";
import { localeFromPath, tFor } from "../i18n/astro";
import { localePath } from "../i18n/paths";

const site = (await getEntry("site", "main"))!.data;
const locale = localeFromPath(Astro.url.pathname);
const t = tFor(locale);
// SEO JSON-LD keeps Home → Account; the visible crumb is `// account`.
const breadcrumbs = [
  { name: "Home", path: localePath(locale, "/") },
  { name: t("account.title"), path: localePath(locale, "/account") },
];
const crumbs = [{ name: t("account.comment"), path: localePath(locale, "/account") }];
---

<BaseLayout
  title={`${t("account.title")} — ${site.name}`}
  description={t("account.lede")}
  path={localePath(locale, "/account")}
  noindex
  breadcrumbs={breadcrumbs}
>
  <main id="main">
    <section
      class="on-ink grid-ink border-b border-line-ink bg-ink pt-[clamp(2.5rem,6vw,4rem)] pb-[clamp(2rem,5vw,3rem)]"
    >
      <Container>
        <Breadcrumbs items={crumbs} />
        <h1
          class="mt-4 font-display text-[clamp(1.9rem,5vw,3rem)] leading-[1] font-bold tracking-[-0.03em] text-cream"
        >
          {t("account.title")}
        </h1>
        <p
          class="mt-3 max-w-[44rem] text-[clamp(0.96rem,1.4vw,1.1rem)] leading-[1.6] text-[rgba(250,250,244,0.7)]"
        >
          {t("account.lede")}
        </p>
      </Container>
    </section>

    <div class="grid-paper bg-paper py-[clamp(2.5rem,6vw,4rem)]">
      <Container>
        <div class="auth-shell">
          <AccountPanel client:load locale={locale} />
        </div>
      </Container>
    </div>
  </main>
</BaseLayout>
