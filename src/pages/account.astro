---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import AccountPanel from "../components/auth/AccountPanel.tsx";

const site = (await getEntry("site", "main"))!.data;
// SEO JSON-LD keeps Home → Account; the visible crumb is `// account`.
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Account", path: "/account" },
];
const crumbs = [{ name: "account", path: "/account" }];
---

<BaseLayout
  title={`Account — ${site.name}`}
  description="Your TypeStar account: email, public handle and sign-out."
  path="/account"
  noindex
  breadcrumbs={breadcrumbs}
>
  <main id="main">
    <section
      class="on-ink grid-ink border-b border-line-ink bg-ink pt-[clamp(2.5rem,6vw,4rem)] pb-[clamp(2rem,5vw,3rem)]"
    >
      <Container>
        <Breadcrumbs items={crumbs} />
        <h1
          class="mt-4 font-display text-[clamp(1.9rem,5vw,3rem)] leading-[1] font-bold tracking-[-0.03em] text-cream"
        >
          Account
        </h1>
        <p
          class="mt-3 max-w-[44rem] text-[clamp(0.96rem,1.4vw,1.1rem)] leading-[1.6] text-[rgba(250,250,244,0.7)]"
        >
          Your email, your public handle and your session.
        </p>
      </Container>
    </section>

    <div class="grid-paper bg-paper py-[clamp(2.5rem,6vw,4rem)]">
      <Container>
        <div class="auth-shell">
          <AccountPanel client:load />
        </div>
      </Container>
    </div>
  </main>
</BaseLayout>
