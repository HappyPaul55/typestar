---
import "../styles/global.css";
import { getEntry } from "astro:content";
import GameApp from "../components/game/GameApp.tsx";
import { localeFromPath } from "../i18n/astro";
import { localePath } from "../i18n/paths";
import { HTML_LANG } from "../i18n/locales";

const site = (await getEntry("site", "main"))!.data;
const locale = localeFromPath(Astro.url.pathname);
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{site.name}</title>
    <meta name="robots" content="noindex, follow" />
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <meta name="theme-color" content="#0c0d0a" />
  </head>
  <body class="embed-body">
    <GameApp client:load site={site} embed locale={locale} />
    <a
      class="embed-badge"
      href={localePath(locale, "/")}
      target="_blank"
      rel="noopener noreferrer"
      title={`Play more on ${site.name}`}
    >
      {site.name}
    </a>
  </body>
</html>
