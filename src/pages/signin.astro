---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import SignInForm from "../components/auth/SignInForm.tsx";

const site = (await getEntry("site", "main"))!.data;
// SEO JSON-LD keeps Home → Sign in; the visible crumb is `// sign in`.
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Sign in", path: "/signin" },
];
const crumbs = [{ name: "sign in", path: "/signin" }];
---

<BaseLayout
  title={`Sign in — ${site.name}`}
  description="Sign in to TypeStar with a one-time email link. No password to remember."
  path="/signin"
  noindex
  breadcrumbs={breadcrumbs}
>
  <main id="main">
    <section
      class="on-ink grid-ink border-b border-line-ink bg-ink pt-[clamp(2.5rem,6vw,4rem)] pb-[clamp(2rem,5vw,3rem)]"
    >
      <Container>
        <Breadcrumbs items={crumbs} />
        <h1
          class="mt-4 font-display text-[clamp(1.9rem,5vw,3rem)] leading-[1] font-bold tracking-[-0.03em] text-cream"
        >
          Sign in
        </h1>
        <p
          class="mt-3 max-w-[44rem] text-[clamp(0.96rem,1.4vw,1.1rem)] leading-[1.6] text-[rgba(250,250,244,0.7)]"
        >
          TypeStar uses a one-time link instead of a password. Enter your email,
          open the link we send, and you&rsquo;re in.
        </p>
      </Container>
    </section>

    <div class="grid-paper bg-paper py-[clamp(2.5rem,6vw,4rem)]">
      <Container>
        <div class="auth-shell">
          <SignInForm client:load />
        </div>
      </Container>
    </div>
  </main>
</BaseLayout>
