---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import ChallengeView from "../components/score/ChallengeView.tsx";

const site = (await getEntry("site", "main"))!.data;
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Challenge", path: "/challenge" },
];
const crumbs = [{ name: "challenge", path: "/challenge" }];
---

<BaseLayout
  title={`Daily challenge — ${site.name}`}
  description="TypeStar's daily and weekly challenge: one song and one modifier, with its own leaderboard."
  path="/challenge"
  breadcrumbs={breadcrumbs}
>
  <main id="main">
    <section
      class="on-ink grid-ink border-b border-line-ink bg-ink pt-[clamp(2.5rem,6vw,4rem)] pb-[clamp(2rem,5vw,3rem)]"
    >
      <Container>
        <Breadcrumbs items={crumbs} />
        <h1
          class="mt-4 font-display text-[clamp(1.9rem,5vw,3rem)] leading-[1] font-bold tracking-[-0.03em] text-cream"
        >
          Daily &amp; weekly challenge
        </h1>
        <p
          class="mt-3 max-w-[46rem] text-[clamp(0.96rem,1.4vw,1.1rem)] leading-[1.6] text-[rgba(250,250,244,0.7)]"
        >
          One song and one modifier per period, with its own typing and singing
          boards. The same for everyone, and it changes on its own.
        </p>
      </Container>
    </section>

    <div class="grid-paper bg-paper py-[clamp(2.5rem,6vw,4rem)]">
      <Container>
        <ChallengeView client:load />
      </Container>
    </div>
  </main>
</BaseLayout>
