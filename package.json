{
  "name": "client-typestar-happypaul55-com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "bun test",
    "knip": "knip",
    "icons": "bun scripts/generate-icons.mjs",
    "tracks:warm": "bun scripts/warm-tracks.ts",
    "tracks:publish": "bun scripts/publish-tracks.ts",
    "tracks:purge": "bun scripts/purge-tracks.ts",
    "tracks:bucket": "wrangler r2 bucket create typestar-tracks",
    "tracks:bucket:preview": "wrangler r2 bucket create typestar-tracks-preview",
    "auth:schema": "bunx auth@latest generate --config scripts/auth-schema.ts --output migrations/0001_auth.sql -y",
    "db:create": "wrangler d1 create typestar-auth",
    "db:create:preview": "wrangler d1 create typestar-auth-preview",
    "db:migrate": "wrangler d1 migrations apply typestar-auth --remote",
    "db:migrate:local": "wrangler d1 migrations apply typestar-auth --local",
    "db:migrate:preview": "wrangler d1 migrations apply typestar-auth-preview --remote",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "better-auth": "^1.7.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "youtube-caption-extractor": "^1.10.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@better-auth/kysely-adapter": "^1.7.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "favicons": "^7.2.0",
    "knip": "^6.41.0",
    "kysely": "^0.29.6",
    "typescript": "^6.0.3"
  }
}
